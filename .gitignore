# ------------------------------------------------------------
# Private configuration files
# Keep config/config.example.json tracked.
# ------------------------------------------------------------
config/config.development.json
config/config.test.json
config/config.production.json
config/*.local.json
config/*.private.json
config/*-local.json
config/*-private.json

# Explicitly keep the public template.
!config/config.example.json

# ------------------------------------------------------------
# Environment variables and credentials
# ------------------------------------------------------------
.env
.env.*
!.env.example
*.env
*.secret
*.secrets
*.credentials
credentials.json
secrets.json

# ------------------------------------------------------------
# Python
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.venv/
venv/
env/
ENV/

# ------------------------------------------------------------
# Jupyter and notebook artifacts
# ------------------------------------------------------------
.ipynb_checkpoints/
*.nbconvert.ipynb

# ------------------------------------------------------------
# Databricks local artifacts
# ------------------------------------------------------------
.databricks/
databricks.yml.local
.databrickscfg
*.dbc

# ------------------------------------------------------------
# Power BI temporary and local artifacts
# The sanitized public PBIX remains tracked.
# ------------------------------------------------------------
*.pbit.tmp
*.pbix.tmp
*.pbix.autosave
*.pbix.lock
*.pbix~
~$*.pbix

# Local Power BI project cache and user-specific settings.
**/.pbi/cache.abf
**/.pbi/localSettings.json
**/.pbi/editorSettings.json

# Explicitly keep the sanitized public report when present.
!power-bi/absenteeism-analytics.pbix

# ------------------------------------------------------------
# Microsoft Office temporary files
# ------------------------------------------------------------
~$*.xlsx
~$*.xls
~$*.docx
~$*.doc
~$*.pptx
~$*.ppt

# ------------------------------------------------------------
# Logs, caches, temporary files, and backups
# ------------------------------------------------------------
*.log
logs/
*.tmp
*.temp
*.bak
*.backup
*.swp
*.swo
*~
.cache/
tmp/
temp/

# ------------------------------------------------------------
# Generated archives and local exports
